# ---------------------------------------------------------------------------
# Supabase copy this file to `.env.local` and fill in real values.
# Find these under: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security never expose to the browser and
# never prefix with NEXT_PUBLIC_. Used by the import script and by the
# integration services (encrypted secrets, sheet sync, email logging).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Credential encryption REQUIRED for the integrations
# ---------------------------------------------------------------------------
# Integration credentials (SMTP password, Gmail App Password, Google service
# account key, n8n API key) are encrypted with AES-256-GCM before being stored,
# so a database dump alone discloses nothing.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this key makes every stored credential unreadable they must then be
# re-entered. Rotating it requires re-entering them too. Keep it backed up
# alongside your other production secrets, and use a DIFFERENT value per
# environment.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Display timezone optional
# ---------------------------------------------------------------------------
# Every timestamp shown in the UI is rendered in this zone. DISPLAY ONLY:
# everything is stored as UTC, and the sending window keeps its own timezone
# setting under Settings, because when the sender may run is a decision about
# the recipients, not about who is reading the screen.
#
# Pinned rather than left to the runtime clock: without it a server-rendered row
# shows UTC (Vercel) and a client-rendered one shows the visitor's zone, so the
# same timestamp could appear two different ways on one page.
#
# Defaults to Asia/Karachi and the label PKT. Any IANA zone name works.
NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Karachi
NEXT_PUBLIC_DISPLAY_TIMEZONE_LABEL=PKT

# ---------------------------------------------------------------------------
# Public site URL optional
# ---------------------------------------------------------------------------
# Used as metadataBase, which turns the relative Open Graph / Twitter image
# paths into the absolute URLs social scrapers require. Leave it blank on
# Vercel: the deployment URL is detected automatically. Set it when the app runs
# behind your own domain or a tunnel.
#   e.g. https://leads-website-alpha.vercel.app
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Scheduled sending REQUIRED for automatic follow-ups
# ---------------------------------------------------------------------------
# Shared secret for the endpoints under /api/cron. Those routes send real email
# and are reachable without a session, so this token is the only thing between
# the open internet and the sender. When it is unset the routes answer 503 and
# scheduled sending is disabled it fails closed, never open.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The scheduler calls it as:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/outreach
#
# On Vercel, vercel.json already declares the cron; set CRON_SECRET as a project
# environment variable and Vercel sends it as the Bearer token automatically.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Inbound mail — REQUIRED for reply ingestion
# ---------------------------------------------------------------------------
# Shared secret for /api/inbound, which the Cloudflare Email Worker in
# cloudflare/email-worker.js calls. Falls back to CRON_SECRET when unset, but
# setting it separately is better: this value lives in a Worker deployed outside
# this repo, and rotating it should not also mean reconfiguring the scheduler.
#
# When neither is set the route answers 503 and inbound mail is disabled.
# It fails closed, never open.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The same value goes into the Worker:
#   wrangler secret put CRM_INBOUND_SECRET
INBOUND_SECRET=

# ---------------------------------------------------------------------------
# Lead import (scripts/import-leads.ts)
# ---------------------------------------------------------------------------
# Path to the workbook, relative to the project root.
LEADS_XLSX_PATH=Leads.xlsx
# Worksheet to import. Sheet2 holds the enriched leads (research + drafts).
LEADS_XLSX_SHEET=Sheet2
