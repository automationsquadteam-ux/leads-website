{
  "name": "leads-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "types:gen": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "import:leads": "tsx scripts/import-leads.ts",
    "import:leads:dry": "tsx scripts/import-leads.ts --dry-run",
    "leads:purge": "tsx scripts/purge-leads.ts",
    "leads:duplicates": "tsx scripts/find-duplicates.ts",
    "emails:export": "tsx scripts/verify-emails.ts export",
    "emails:import": "tsx scripts/verify-emails.ts import",
    "emails:status": "tsx scripts/verify-emails.ts status"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
